# PORTERS Connect API credentials (provided on contract).
# Copy to .env and fill in. NEVER commit real values.
# 契約で渡されるのは**サーバー名**（ポートは含まれません）。
PORTERS_HOST=
PORTERS_APP_ID=
PORTERS_APP_SECRET=

# Optional. Only for a local fake server or a proxy — PORTERS itself needs no port.
# The library never reads this itself: pass it as `port` when constructing PortersClient.
PORTERS_PORT=

# Optional. Empty or unset = https (production). Set to `http` only to point the app at a local
# fake server (`pnpm fake:serve`) — cleartext, so the library warns once per process.
# The library never reads this itself: pass it as `scheme` when constructing PortersClient.
PORTERS_SCHEME=
